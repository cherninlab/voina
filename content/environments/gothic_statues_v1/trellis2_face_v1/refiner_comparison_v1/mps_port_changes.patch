+def _fps_pytorch(
+    src: torch.Tensor,
+    batch: Optional[Tensor] = None,
+    ratio: float = 0.5,
+    random_start: bool = True,
+    batch_size: Optional[int] = None,
+):
+    """
+    Pure PyTorch implementation of Farthest Point Sampling.
+    This is slower than torch_cluster but works on MPS and CPU.
+    """
+    device = src.device
+    n_points = src.shape[0]
+
+    if batch is None:
+        batch = torch.zeros(n_points, dtype=torch.long, device=device)
+
+    if batch_size is None:
+        batch_size = int(batch.max().item()) + 1
+
+    # Calculate number of points to sample per batch
+    n_sample = int(n_points / batch_size * ratio)
+
+    selected_indices = []
+
+    for b in range(batch_size):
+        mask = batch == b
+        points = src[mask]
+        n_pts = points.shape[0]
+        n_sel = min(n_sample, n_pts)
+
+        if n_sel == 0:
+            continue
+
+        # Initialize distances to infinity
+        distances = torch.full((n_pts,), float('inf'), device=device)
+
+        # Pick starting point
+        if random_start:
+            idx = torch.randint(0, n_pts, (1,), device=device).item()
+        else:
+            idx = 0
+
+        batch_selected = [idx]
+
+        for _ in range(n_sel - 1):
+            # Update distances
+            current_point = points[idx:idx+1]
+            dist_to_current = torch.cdist(points, current_point).squeeze(-1)
+            distances = torch.min(distances, dist_to_current)
+
+            # Select farthest point
+            idx = torch.argmax(distances).item()
+            batch_selected.append(idx)
+
+        # Convert local indices to global indices
+        global_indices = torch.where(mask)[0]
+        selected_indices.extend(global_indices[batch_selected].tolist())
+
+    return torch.tensor(selected_indices, dtype=torch.long, device=device)
+
