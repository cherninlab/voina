config_version=5

[application]
config/name="SECHA"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Voina"
run/main_scene="res://gameplay/match_world.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]
InputSettings="*res://core/input_settings.gd"
NetworkManager="*res://core/network_manager.gd"
BuildSync="*res://core/build_sync.gd"
NetMonitor="*res://core/net_monitor.gd"
Projectiles="*res://gameplay/projectile/projectile_system.gd"
Wildlife="*res://gameplay/wildlife/wildlife.gd"

[display]
window/size/viewport_width=1152
window/size/viewport_height=720

[rendering]
renderer/rendering_method="mobile"
rendering_device/driver.macos="metal"
scaling_3d/scale=1.0
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=3
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/physics_engine="Jolt Physics"

[debug]
gdscript/warnings/untyped_declaration=2
